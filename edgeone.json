{
  "buildCommand": "npm run build",
  "outputDirectory": "./public",
  "installCommand": "npm install",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/usr/themes/joe/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/upload/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
