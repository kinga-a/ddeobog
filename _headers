# 静态资源长缓存（1年）
# 文件名带 hash 的可以永久缓存，不带的用较短缓存

# CSS 文件
/usr/themes/joe/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# JS 文件
/usr/themes/joe/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# 图片资源（png/jpg/gif/svg/webp）
/usr/themes/joe/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/usr/themes/joe/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/usr/themes/joe/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/usr/themes/joe/assets/*.gif
  Cache-Control: public, max-age=31536000, immutable
/usr/themes/joe/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable
/usr/themes/joe/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable

# 字体文件
/usr/themes/joe/assets/*.woff
  Cache-Control: public, max-age=31536000, immutable
/usr/themes/joe/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/usr/themes/joe/assets/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/usr/themes/joe/assets/*.eot
  Cache-Control: public, max-age=31536000, immutable
